# Database
POSTGRES_USER=sahub
POSTGRES_PASSWORD=sahub_dev
POSTGRES_DB=saudi_health_hub
# Note: Docker Postgres is mapped to 5433 to avoid conflict with any native Postgres on 5432
DATABASE_URL=postgresql://sahub:sahub_dev@127.0.0.1:5433/saudi_health_hub

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=saudi_health_hub

# Cache
REDIS_URL=redis://localhost:6379

# AI
ANTHROPIC_API_KEY=your_anthropic_key_here
COHERE_API_KEY=your_cohere_key_here

# Auth (NextAuth)
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Backend
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
